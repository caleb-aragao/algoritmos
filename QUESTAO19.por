programa {
    funcao inicio() {
        escreva(" PREPARAÇÃO PARA O LANÇAMENTO \n\n")

        // O laço inicia em 10, continua enquanto i for maior ou igual a 1, e diminui de 1 em 1 (i--)
        para (inteiro i = 10; i >= 1; i--) {
            escreva(i, "...\n")
        }

        escreva("\nDECOLAR! 🚀\n")
    }
}
